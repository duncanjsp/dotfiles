#!/bin/bash
# age wrapper that reads the identity from 1Password. Lives in the source dir
# so it works before anything has been applied.
set -eo pipefail

OP_REF="op://Private/Chezmoi encryption/age key/private key"

# stevenson-price family account
OP_ACCOUNT="${OP_ACCOUNT:-353UNSKZKJHK5FKSKUOTREIGEA}"

# Drop chezmoi's --identity; ours comes in on a file descriptor.
args=()
skip=0
decrypt=0
for arg in "$@"; do
	if [ "$skip" -eq 1 ]; then
		skip=0
		continue
	fi
	case "$arg" in
	-i | --identity)
		skip=1
		;;
	-d | --decrypt)
		decrypt=1
		args+=("$arg")
		;;
	*)
		args+=("$arg")
		;;
	esac
done

if [ "$decrypt" -eq 1 ]; then
	if ! command -v op >/dev/null 2>&1; then
		echo "age-op: 1Password CLI (op) not found; cannot fetch age identity" >&2
		exit 1
	fi
	exec age "${args[@]}" -i <(op read --account "$OP_ACCOUNT" "$OP_REF")
fi

exec age "${args[@]}"
