#!/usr/bin/env bash
# Touch ~/.claude/.statusline-debug to dump payloads per session.

set -uo pipefail

# read returns nonzero at EOF having still filled the variable, hence || true.
IFS= read -r -d '' payload || true

if [[ -f "$HOME/.claude/.statusline-debug" ]]; then
  [[ $payload =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]] &&
    printf '%s' "$payload" >"$HOME/.claude/.statusline-payload-${BASH_REMATCH[1]}.json"
fi

{{ $palette := (index .themes .theme).palette -}}
ansi() {
  local h=${1#\#}
  printf '\033[38;2;%d;%d;%dm' "$((16#${h:0:2}))" "$((16#${h:2:2}))" "$((16#${h:4:2}))"
}

c_plain=$(ansi '{{ $palette.fg_plain }}')
c_accent=$(ansi '{{ $palette.accent }}')
c_path=$(ansi '{{ $palette.path }}')
c_ok=$(ansi '{{ $palette.ok }}')
c_warn=$(ansi '{{ $palette.warn }}')
c_error=$(ansi '{{ $palette.error }}')
c_info=$(ansi '{{ $palette.info }}')
c_remote=$(ansi '{{ $palette.remote }}')
c_dim=$'\033[2m'
c_bold=$'\033[1m'
c_reset=$'\033[0m'

# Regex rather than jq: a second jq call costs more than the whole render.
[[ $payload =~ \"current_dir\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]] &&
  probe=${BASH_REMATCH[1]} || probe=""

# jj before git: in a colocated repo .git/HEAD is always detached.
vcs_kind="" vcs_name="" vcs_rev_pre="" vcs_rev_suf="" vcs_ahead=0
while [[ -n $probe && $probe != / ]]; do
  if [[ -d $probe/.jj ]]; then
    # --ignore-working-copy stops jj snapshotting (a slow write) on every
    # render. Rows between the bookmark and @ have no bookmark of their own, so
    # an empty first field counts one revision ahead.
    bm='heads(::@ & bookmarks())'
    # Not IFS=$'\t': tab is IFS whitespace, so read would drop the empty
    # leading field.
    while IFS= read -r line; do
      name=${line%%$'\t'*}
      tail=${line#*$'\t'}
      pre=${tail%%$'\t'*}
      tail=${tail#*$'\t'}
      suf=${tail%%$'\t'*}
      wc=${tail#*$'\t'}
      [[ $wc == "@" ]] && vcs_rev_pre=$pre vcs_rev_suf=$suf
      if [[ -n $name ]]; then
        vcs_name=${name%% *}
      else
        vcs_ahead=$((vcs_ahead + 1))
      fi
    done < <(jj -R "$probe" log --no-graph --ignore-working-copy \
      -r "$bm | ($bm..@)" \
      -T 'bookmarks ++ "\t" ++ change_id.shortest(8).prefix() ++ "\t"
          ++ change_id.shortest(8).rest() ++ "\t"
          ++ if(current_working_copy, "@", "") ++ "\n"' 2>/dev/null)
    [[ -n $vcs_name || -n $vcs_rev_pre ]] && vcs_kind=jj
    break
  elif [[ -f $probe/.git/HEAD ]]; then
    read -r head <"$probe/.git/HEAD" 2>/dev/null || head=""
    [[ $head == ref:* ]] && vcs_name=${head##*/} vcs_kind=git
    break
  elif [[ -f $probe/.git ]]; then
    break # worktree or submodule; the payload covers these
  fi
  probe=${probe%/*}
done

printf '%s' "$payload" | jq -r \
  --arg plain "$c_plain" --arg accent "$c_accent" --arg path "$c_path" \
  --arg ok "$c_ok" --arg warn "$c_warn" --arg error "$c_error" \
  --arg info "$c_info" --arg remote "$c_remote" --arg dim "$c_dim" \
  --arg bold "$c_bold" --arg reset "$c_reset" \
  --arg vcs_name "$vcs_name" --arg vcs_kind "$vcs_kind" \
  --arg vcs_rev_pre "$vcs_rev_pre" --arg vcs_rev_suf "$vcs_rev_suf" \
  --arg vcs_ahead "$vcs_ahead" --arg home "$HOME" '

# Escapes because Nerd Font glyphs are Private Use Area characters that some
# tools mangle.
def g_dir:      "\uf07b";  # nf-fa-folder
def g_bookmark: "\uf02e";  # nf-fa-bookmark
def g_branch:   "\ue725";  # nf-dev-git_branch
def g_fast:     "\uf0e7";  # nf-fa-bolt
def g_up:       "\u2191";
def g_model:    "\u25c6";
def g_agent:    "\u25c7";
def g_worktree: "\u2442";
def g_on:       "\u25b0";
def g_off:      "\u25b1";
def g_ellip:    "\u2026";
def g_sep:      "\u00b7";

def rep($s; $n): if $n > 0 then $s * $n else "" end;

# Not plain rounding: any usage shows a cell, and only 100% fills the bar.
def bar($pct; $w):
  (if $pct < 0 then 0 elif $pct > 100 then 100 else $pct end) as $p
  | (if $p <= 0 then 0
     elif $p >= 100 then $w
     else ([1, (($p * $w / 100) | floor)] | max) end) as $f
  | rep(g_on; $f) + rep(g_off; $w - $f);

def heat($pct): if $pct >= 85 then $error elif $pct >= 60 then $warn else $ok end;

def usd:
  (. * 100 | round) as $c
  | (($c / 100) | floor | tostring) + "."
    + (($c % 100) | tostring | if length == 1 then "0" + . else . end);

def until($ts):
  (($ts - now) | floor) as $s
  | if $s <= 0 then "now"
    elif $s < 3600 then (($s / 60) | floor | tostring) + "m"
    elif $s < 86400 then (($s / 3600) | floor | tostring) + "h"
                          + ((($s % 3600) / 60) | floor | tostring) + "m"
    else (($s / 86400) | floor | tostring) + "d"
         + ((($s % 86400) / 3600) | floor | tostring) + "h" end;

def resets($w; $p):
  if $p >= 80 and ($w.resets_at // null) != null
  then $dim + $plain + " " + until($w.resets_at) + $reset
  else "" end;

def sep: $dim + $plain + "  " + g_sep + "  " + $reset;
def gap: $dim + $plain + "   " + $reset;

def cwd:
  (.workspace.current_dir // "")
  | if startswith($home) then "~" + .[($home | length):] else . end
  | (split("/")) as $p
  | if (length <= 56) or (($p | length) <= 3) then .
    else $p[0] + "/" + g_ellip + "/" + ($p[-2:] | join("/")) end;

[

([
  (if cwd != "" then $path + g_dir + " " + cwd + $reset else empty end),

  (if (.worktree.branch // "") != "" then
     $ok + g_branch + " " + .worktree.branch + $reset
   elif $vcs_kind == "jj" then
     (if $vcs_name != "" then $ok + g_bookmark + " " + $vcs_name + $reset else "" end)
     + (if $vcs_ahead != "0" then $warn + " " + g_up + $vcs_ahead + $reset else "" end)
     + (if $vcs_rev_pre != "" then
          " " + $accent + $bold + $vcs_rev_pre + $reset
          + $dim + $plain + $vcs_rev_suf + $reset
        else "" end)
   elif $vcs_kind == "git" then $ok + g_branch + " " + $vcs_name + $reset
   else empty end),

  (if .worktree.name then $accent + g_worktree + " " + .worktree.name + $reset
   else empty end),

  (if .agent.name then $remote + g_agent + " " + .agent.name + $reset else empty end),

  (if .remote then $remote + g_agent + " remote" + $reset else empty end)
]
| join(gap)),

([
  ($accent + g_model + " " + $bold + (.model.display_name // "?") + $reset
   + (if .effort.level then " " + $warn + .effort.level + $reset else "" end)
   + (if .fast_mode then " " + $warn + g_fast + $reset else "" end)),

  (if .permission_mode and .permission_mode != "default" and .permission_mode != "auto" then
     $warn + .permission_mode + $reset
   else empty end),

  (if .context_window.used_percentage != null then
     (.context_window.used_percentage) as $p
     | $dim + $plain + "ctx " + $reset + heat($p) + bar($p; 10)
       + " " + ($p | floor | tostring) + "%" + $reset
   else empty end),

  (if .rate_limits.five_hour then
     (.rate_limits.five_hour.used_percentage) as $p
     | $dim + $plain + "5h " + $reset + heat($p) + bar($p; 5)
       + " " + ($p | floor | tostring) + "%" + $reset
       + resets(.rate_limits.five_hour; $p)
   else empty end),

  (if .rate_limits.seven_day then
     (.rate_limits.seven_day.used_percentage) as $p
     | $dim + $plain + "7d " + $reset + heat($p) + bar($p; 5)
       + " " + ($p | floor | tostring) + "%" + $reset
       + resets(.rate_limits.seven_day; $p)
   else empty end),

  (if .rate_limits.spend_limit then
     (.rate_limits.spend_limit.used_percentage) as $p
     | $dim + $plain + "budget " + $reset + heat($p)
       + ($p | floor | tostring) + "%" + $reset
       + resets(.rate_limits.spend_limit; $p)
   else empty end),

  (if .cost.total_cost_usd then
     $info + "$" + (.cost.total_cost_usd | usd) + $reset
   else empty end)
]
| join(sep))
]
| map(select(length > 0)) | .[]
' 2>/dev/null || printf '%s' "${c_error}statusline error${c_reset}"
