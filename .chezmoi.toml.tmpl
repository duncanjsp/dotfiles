{{- /* Unknown hosts default to gui = false so a scripted bootstrap is safe. */ -}}
{{- $profile := "personal" -}}
{{- $gui := true -}}
{{- if eq .chezmoi.hostname "test-track" -}}
{{-   $profile = "work" -}}
{{- else if ne .chezmoi.hostname "fantasmic" -}}
{{-   $gui = promptBoolOnce . "gui" "Desktop machine (install GUI configs)" false -}}
{{- end -}}
{{- $email := promptStringOnce . "email" "Email address" "duncan@psmail.co" -}}

encryption = "age"

[data]
email = {{ $email | quote }}
profile = {{ $profile | quote }}
gui = {{ $gui }}

[age]
command = {{ (joinPath .chezmoi.sourceDir "bin/age-op") | quote }}
recipient = "age13maate0garz665d5le655t2vdctuwz4s8plfnu0xpjvwkmhmhe3sxvdgwe"
