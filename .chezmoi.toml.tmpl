{{- /* Three axes: profile (personal|work), .chezmoi.os, and gui. A server is
       Linux with gui = false rather than a profile of its own. */ -}}
{{- $profile := "personal" -}}
{{- $gui := true -}}
{{- if eq .chezmoi.hostname "test-track" -}}
{{-   $profile = "work" -}}
{{- else if ne .chezmoi.hostname "fantasmic" -}}
{{-   /* Defaults to false so a non-interactive server bootstrap is safe. */ -}}
{{-   $gui = promptBoolOnce . "gui" "Desktop machine (install GUI configs)" false -}}
{{- end -}}
{{- $email := promptStringOnce . "email" "Email address" "duncan@psmail.co" -}}

encryption = "age"

[data]
email = {{ $email | quote }}
profile = {{ $profile | quote }}
gui = {{ $gui }}

# No identity on disk: bin/age-op fetches the key from 1Password at decrypt time.
[age]
command = {{ (joinPath .chezmoi.sourceDir "bin/age-op") | quote }}
recipient = "age13maate0garz665d5le655t2vdctuwz4s8plfnu0xpjvwkmhmhe3sxvdgwe"
