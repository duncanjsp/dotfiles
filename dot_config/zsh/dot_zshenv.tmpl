{{ if ne .chezmoi.os "darwin" -}}
# Remote boxes often have no LANG; without one zsh mismeasures the prompt.
case "${LANG:-}" in
"" | C | POSIX) export LANG=C.UTF-8 ;;
esac

# gnome-keyring grabs this but has no signing key. A forwarded agent wins.
if [[ -z "${SSH_CONNECTION:-}" && -S "$HOME/.1password/agent.sock" ]]; then
	export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
fi

{{ end -}}
# Configure XDG Base Directory
export XDG_CONFIG_HOME=$HOME/.config
export XDG_DATA_HOME=$HOME/.local/share
export XDG_CACHE_HOME=$HOME/.cache
export XDG_STATE_HOME=$HOME/.local/state

# Configure XDG Runtime Directory
if [ "$(uname)" = "Linux" ]; then
  export XDG_RUNTIME_DIR="/run/user/$UID"
else
  # TMPDIR is normally the per-user /var/folders/.../T/ with a trailing slash,
  # but not always (some launch contexts hand down a bare /private/tmp), so
  # normalise rather than assuming the separator is there.
  _tmpdir="${TMPDIR:-/tmp}"
  export XDG_RUNTIME_DIR="${_tmpdir%/}/xdg-runtime-$UID"
  unset _tmpdir
fi

# Ensure XDG_RUNTIME_DIR exists
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
fi

# Configure apps to use XDG Directories
export ZDOTDIR=$XDG_CONFIG_HOME/zsh
export ZCOMPDUMP="$XDG_CACHE_HOME"/zsh/zcompdump

export BUNDLE_USER_CONFIG="$XDG_CONFIG_HOME"/bundle
export BUNDLE_USER_CACHE="$XDG_CACHE_HOME"/bundle
export BUNDLE_USER_PLUGIN="$XDG_DATA_HOME"/bundle

export NPM_CONFIG_USERCONFIG=$XDG_CONFIG_HOME/npm/config
export NPM_CONFIG_CACHE=$XDG_CACHE_HOME/npm

export LESSHISTFILE="$XDG_DATA_HOME/less/lesshst"
{{- if ne .profile "work" }}

export GOPATH="$XDG_DATA_HOME"/go
export GOBIN="$XDG_DATA_HOME"/go/bin
{{- end }}
