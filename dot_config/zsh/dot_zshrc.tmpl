# Set additional XDG Dirs as required
export HISTFILE=$XDG_DATA_HOME/zsh/history
[[ -d ${HISTFILE:h} ]] || mkdir -p ${HISTFILE:h}

# Path Configuration
{{ if eq .chezmoi.os "darwin" -}}
export PATH="$HOME/.local/bin:/opt/homebrew/opt/node@20/bin:$PATH"
{{- else -}}
export PATH="$HOME/.local/bin:$PATH"
{{- end }}

# nvim for all editor invocations. VISUAL is deliberately unset: tools prefer it
# over EDITOR, which would open Zed from the terminal. Use `zed {file}` directly.
export EDITOR="nvim"

# $SHELL comes from /etc/passwd, so it lies wherever chsh never ran.
[[ -n "${commands[zsh]}" ]] && export SHELL="${commands[zsh]}"

{{ if ne .chezmoi.os "darwin" -}}
# Not .zprofile: herdr's panes are non-login on Linux and never read it.
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

{{ end -}}
# Must come first: on Linux everything below comes from mise.
command -v mise >/dev/null && eval "$(mise activate zsh)"
{{ if .gui }}
# After mise, which provides herdr on Linux. Unguarded, a failed exec of a
# missing command exits zsh outright rather than reaching `|| exit`.
if [[ -z "$HERDR_ENV" && -z "$SSH_CONNECTION" && "$GHOSTTY_QUICK_TERMINAL" != "1" ]] && command -v herdr >/dev/null; then
	exec herdr || exit
fi
{{ end }}
# OhMyPosh Config https://ohmyposh.dev/docs/
command -v oh-my-posh >/dev/null && eval "$(oh-my-posh init zsh --config $XDG_CONFIG_HOME/ohmyposh/config.toml)"

# Load Atuin: https://atuin.sh/
command -v atuin >/dev/null && eval "$(atuin init zsh)"

# Load supplementary configuration files
if [ -d "$XDG_CONFIG_HOME/zsh/resources" ]; then
	for file in "$XDG_CONFIG_HOME/zsh/resources"/*.zsh; do
		[ -r "$file" ] && source "$file"
	done
fi

autoload -U compinit && compinit
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense' # optional
export CARAPACE_MATCH=1                                # case-insensitive completion
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}' # case-insensitive fallback for non-carapace completions
zstyle ':completion:*' menu select                     # menu selection
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" # color completion
command -v carapace >/dev/null && source <(carapace _carapace)

# `|| true` keeps $? at 0 for the first prompt: this is the last line of the
# file, so a skipped fastfetch would otherwise show as an error in the prompt.
command -v fastfetch >/dev/null && fastfetch || true
