alias ll="eza -al --no-user --time-style long-iso --icons --git"
alias lt="eza -aTL 3 --icons"

# bar is a better cat with syntax highlighting
alias cat="bat"

# Handy git aliases
alias gwip='git add -A; git rm $(git ls-files --deleted) 2> /dev/null; git commit --no-verify --no-gpg-sign --message "--wip-- [skip ci]"'
alias gunwip='git rev-list --max-count=1 --format="%s" HEAD | grep -q "\--wip--" && git reset HEAD~1'
# Route `chezmoi diff` through revdiff; all other subcommands pass through
# untouched. Reviewing a diff is not a desktop-only activity, so this is not
# gated on the GUI — but revdiff is guarded, because a shell function that
# assumes a binary exists turns a missing package into a broken command.
chezmoi() {
  if [[ "$1" == "diff" ]] && command -v revdiff >/dev/null; then
    command chezmoi diff "${@:2}" | revdiff --stdin
  else
    command chezmoi "$@"
  fi
}
