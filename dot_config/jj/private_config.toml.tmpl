#:schema https://docs.jj-vcs.dev/latest/config-schema.json

[user]
name = "Duncan Stevenson-Price"
email = "{{ .email }}"

[signing]
{{- /* No 1Password binary on servers; "own" would make every jj command fail,
       not just commits, because signing happens on working-copy snapshots. */}}
behavior = {{ if eq .profile "server" }}"drop"{{ else }}"own"{{ end }}
backend = "ssh"
{{- if eq .profile "work" }}
key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAEDbXQOIRzbFI6Q3q0RHWVHloBrEcNagqPfk4fhbtsY"
{{- else }}
key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL2ypgsJT6cu614LIGHPhNEK+l084Txm7SjkMZVPlX0z"
{{- end }}
{{- if ne .profile "server" }}
backends.ssh.program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- end }}

[[--scope]]
--when.commands = ["diff"]
[--scope.ui]
diff-formatter = ":git"
pager = ["revdiff", "--stdin"]
color = "never"
