#:schema https://docs.jj-vcs.dev/latest/config-schema.json

[user]
name = "Duncan Stevenson-Price"
email = "{{ .email }}"

[signing]
{{- /* Without the 1Password desktop app "own" would make every jj command fail,
       not just commits, because signing happens on working-copy snapshots. */}}
behavior = {{ if .gui }}"own"{{ else }}"drop"{{ end }}
backend = "ssh"
{{- if eq .profile "work" }}
key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAEDbXQOIRzbFI6Q3q0RHWVHloBrEcNagqPfk4fhbtsY"
{{- else }}
key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL2ypgsJT6cu614LIGHPhNEK+l084Txm7SjkMZVPlX0z"
{{- end }}
{{- if .gui }}
backends.ssh.program = "{{ if eq .chezmoi.os "darwin" }}/Applications/1Password.app/Contents/MacOS/op-ssh-sign{{ else }}/opt/1Password/op-ssh-sign{{ end }}"
{{- end }}

[[--scope]]
--when.commands = ["diff"]
[--scope.ui]
diff-formatter = ":git"
pager = ["revdiff", "--stdin"]
color = "never"
