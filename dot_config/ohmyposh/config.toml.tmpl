# chezmoi:template:left-delimiter={% right-delimiter=%}
# chezmoi's delimiters are moved aside because this file already speaks two
# other dialects: oh-my-posh's own {{ }} templates, and TOML's [[ ]] arrays of
# tables. Only the percent-brace pairs below are chezmoi's; everything else
# passes through untouched.
console_title_template = '{{ .Shell }} in {{ .Folder }}'
version = 4
final_space = true

# Slots are keyed by role rather than hue, so segments below say p:path and
# p:error instead of p:orange and p:red, and a theme can pick whatever colour
# a role deserves. Values come from .chezmoidata/theme.yaml.
#
# The rule every segment follows: a coloured background always takes
# p:fg_on_accent, and a transparent background always takes a light accent as
# its foreground. Never light-on-light.
{%- $palette := (index .themes .theme).palette %}
[palette]
  fg_on_accent = {% $palette.fg_on_accent | squote %}
  fg_plain = {% $palette.fg_plain | squote %}
  accent = {% $palette.accent | squote %}
  remote = {% $palette.remote | squote %}
  path = {% $palette.path | squote %}
  ok = {% $palette.ok | squote %}
  warn = {% $palette.warn | squote %}
  error = {% $palette.error | squote %}
  info = {% $palette.info | squote %}
  behind = {% $palette.behind | squote %}

[secondary_prompt]
  template = '<p:accent,transparent></><,p:accent> > </><p:accent,transparent></> '
  foreground = 'p:fg_on_accent'
  background = 'transparent'

[transient_prompt]
  template = '<p:accent,transparent></><,p:accent> {{ .PWD }} </><p:accent,transparent></> '
  foreground = 'p:fg_on_accent'
  background = 'transparent'

[upgrade]
  source = 'cdn'
  interval = '168h'
  auto = false
  notice = false

[[blocks]]
  type = 'prompt'
  alignment = 'left'

  [[blocks.segments]]
    leading_diamond = ''
    trailing_diamond = ''
    template = '{{ if eq .OS "darwin" }} {{ else }} {{ end }}{{ .UserName }}{{ if .SSHSession }}@{{ .HostName }}{{ end }} '
    foreground = 'p:fg_on_accent'
    background = 'p:accent'
    background_templates = ['{{ if .SSHSession }}p:remote{{ end }}']
    type = 'session'
    style = 'diamond'

  [[blocks.segments]]
    template = ' {{ path .Path .Location }} '
    foreground = 'p:fg_on_accent'
    powerline_symbol = ''
    background = 'p:path'
    type = 'path'
    style = 'powerline'

  [[blocks.segments]]
    template = ' jj {{ if .ClosestBookmarks }}{{ .ClosestBookmarks }} {{ end }}{{ .ChangeID }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }} '
    foreground = 'p:fg_on_accent'
    powerline_symbol = ''
    background = 'p:ok'
    type = 'jujutsu'
    style = 'powerline'
    background_templates = ['{{ if .Working.Changed }}p:warn{{ end }}']

    [blocks.segments.options]
      fetch_status = true
      ignore_working_copy = false
      fetch_ahead_counter = true
      ahead_icon = '⇡'

  [[blocks.segments]]
    template = ' {{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ end }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} '
    foreground = 'p:fg_on_accent'
    powerline_symbol = ''
    background = 'p:ok'
    type = 'git'
    style = 'powerline'
    background_templates = ['{{ if or (.Working.Changed) (.Staging.Changed) }}p:warn{{ end }}', '{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:error{{ end }}', '{{ if gt .Ahead 0 }}p:info{{ end }}', '{{ if gt .Behind 0 }}p:behind{{ end }}']

    [blocks.segments.options]
      disable_with_jj = true

  [[blocks.segments]]
    template = '  '
    foreground = 'p:fg_on_accent'
    powerline_symbol = ''
    background = 'p:error'
    type = 'root'
    style = 'powerline'

  [[blocks.segments]]
    leading_diamond = '<transparent,background></>'
    trailing_diamond = ''
    template = ' {{ if gt .Code 0 }}{{ else }}{{ end }} '
    foreground = 'p:fg_on_accent'
    background = 'p:info'
    type = 'status'
    style = 'diamond'
    background_templates = ['{{ if gt .Code 0 }}p:error{{ end }}']

[[blocks]]
  type = 'rprompt'

  [[blocks.segments]]
    template = ' {{ .Full }} '
    foreground = 'p:ok'
    background = 'transparent'
    type = 'node'
    style = 'plain'

  [[blocks.segments]]
    template = ' '
    foreground = 'p:info'
    background = 'transparent'
    type = 'go'
    style = 'plain'

  [[blocks.segments]]
    template = ' {{ .Full }} '
    foreground = 'p:warn'
    background = 'transparent'
    type = 'ruby'
    style = 'plain'

  [[blocks.segments]]
    template = ' '
    foreground = 'p:warn'
    background = 'transparent'
    type = 'python'
    style = 'plain'

  [[blocks.segments]]
    template = 'in <p:info><b>{{ .Name }}</b></> '
    foreground = 'p:fg_plain'
    background = 'transparent'
    type = 'shell'
    style = 'plain'

  [[blocks.segments]]
    template = '󱄅 '
    foreground = 'p:info'
    background = 'transparent'
    type = 'nix-shell'
    style = 'powerline'

  [[blocks.segments]]
    template = 'at <p:info><b>{{ .CurrentDate | date "15:04:05" }}</b></>'
    foreground = 'p:fg_plain'
    background = 'transparent'
    type = 'time'
    style = 'plain'

[[blocks]]
  type = 'prompt'
  alignment = 'left'
  newline = true

  [[blocks.segments]]
    template = ''
    foreground = 'p:fg_plain'
    background = 'transparent'
    type = 'text'
    style = 'plain'

[[tooltips]]
  leading_diamond = ''
  trailing_diamond = ''
  template = '  {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} '
  foreground = 'p:fg_on_accent'
  background = 'p:warn'
  type = 'aws'
  style = 'diamond'
  tips = ['aws']

[[tooltips]]
  leading_diamond = ''
  trailing_diamond = ''
  template = '  {{ .Name }} '
  foreground = 'p:fg_on_accent'
  background = 'p:info'
  type = 'az'
  style = 'diamond'
  tips = ['az']
