{{- if lookPath "nvim" -}}
#!/bin/bash
# Re-runs when these change:
#   lsp.lua     {{ include "dot_config/nvim/lua/plugins/lsp.lua" | sha256sum }}
#   parsers.lua {{ include "dot_config/nvim/lua/config/parsers.lua" | sha256sum }}
#   blink.lua   {{ include "dot_config/nvim/lua/plugins/blink.lua" | sha256sum }}
set -eo pipefail

{{ template "lib/output.sh" . }}

header "Neovim tooling"

# Without these, Mason fails once per package; nvim retries on next launch.
for tool in node tree-sitter; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		warn "$tool not on PATH; skipping (nvim will install on next launch)"
		exit 0
	fi
done

say "syncing plugins"
nvim --headless "+Lazy! sync" +qa

# The non-Sync variant returns before anything has downloaded.
say "installing LSP servers and tools"
nvim --headless "+MasonToolsInstallSync" +qa

# blink.cmp otherwise fetches its Rust matcher on first InsertEnter.
say "fetching completion matcher"
nvim --headless \
	-c 'lua require("blink.cmp")' \
	-c 'lua vim.wait(120000, function() return vim.uv.fs_stat(vim.fn.stdpath("data") .. "/lazy/blink.cmp/target/release/version") ~= nil end, 500)' \
	-c 'qa'

# No TSUpdateSync on nvim-treesitter's `main` branch, but install() returns a
# waitable task.
say "building Treesitter parsers"
nvim --headless \
	-c 'lua require("nvim-treesitter.install").install(require("config.parsers")):wait(600000)' \
	-c 'qa'
{{ end -}}
